# Required Microsoft account that owns Minecraft Java and can join the Realm.
BOT_EMAIL=your_email@example.org

# Optional Realm selector. REALM_ID takes precedence over REALM_NAME.
# If neither is set, the first open Realm is selected.
REALM_ID=
REALM_NAME=

# Optional reconnect setting.
RECONNECT_DELAY_MS=5000

# Automatically look down and continuously right-click underfoot.
AUTO_SLEEP_ENABLED=false
SLEEP_CLICK_INTERVAL_MS=1000

# Automatically request respawn after death.
AUTO_RESPAWN_ENABLED=false
RESPAWN_DELAY_MS=500

# Automatically attack the nearest hostile mob within three blocks.
AUTO_ATTACK_ENABLED=false
ATTACK_INTERVAL_MS=1000

# Eat safe food from main inventory or offhand when its full recovery will be used.
AUTO_EAT_ENABLED=false

# Optional local proxy and HAProxy settings.
SET_HAPROXY=true
PROXY_HOST=127.0.0.1
PROXY_PORT=25565
HAPROXY_CONFIG=/etc/haproxy/haproxy.cfg
